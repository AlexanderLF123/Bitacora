# Puerto en el que corre la aplicación (Render asigna PORT automáticamente)
PORT=3050

# URL de Firebase Realtime Database
# Ejemplo: https://tu-proyecto-default-rtdb.firebaseio.com/
FIREBASE_DATABASE_URL=

# Credenciales de Firebase Admin (Opciones):
# Opción 1: Ruta al archivo JSON de credenciales descargado de Firebase Console
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-key.json
#
# Opción 2: El contenido JSON completo de la clave de servicio (Recomendado para Render)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
